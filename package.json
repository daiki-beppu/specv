{
  "name": "specv",
  "version": "0.5.0",
  "description": "Local Markdown preview with GitHub-style rendering",
  "keywords": [
    "cli",
    "markdown",
    "preview"
  ],
  "homepage": "https://github.com/daiki-beppu/specv",
  "bugs": {
    "url": "https://github.com/daiki-beppu/specv/issues"
  },
  "license": "MIT",
  "author": "daiki-beppu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daiki-beppu/specv.git"
  },
  "bin": {
    "specv": "./dist/server/cli.js"
  },
  "files": [
    "dist/"
  ],
  "type": "module",
  "scripts": {
    "dev": "pnpm run dev:server & pnpm run dev:client",
    "dev:client": "vite",
    "dev:server": "tsx src/server/cli.ts",
    "build:client": "vite build",
    "build:server": "tsup src/server/cli.ts --format esm --out-dir dist/server --dts",
    "build": "pnpm run build:client && pnpm run build:server",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "prepublishOnly": "pnpm run build",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "knip": "knip",
    "typecheck": "tsc --noEmit",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "cmdk": "^1.1.1",
    "commander": "^14.0.3",
    "hono": "^4.12.7",
    "katex": "^0.16.38",
    "mermaid": "^11.13.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-emoji": "^5.0.2",
    "remark-github-blockquote-alert": "^2.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.2.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-hotkeys": "^0.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^28.0.0",
    "@types/node": "^25.4.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fzf": "^0.5.2",
    "jsdom": "^28.1.0",
    "knip": "^5.86.0",
    "lefthook": "^2.1.3",
    "lucide-react": "^0.577.0",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shadcn": "^4.0.5",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "ultracite": "7.3.2",
    "unified": "^11.0.5",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@10.32.1"
}