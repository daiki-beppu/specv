{
  "name": "specv",
  "version": "0.8.2",
  "description": "Local Markdown preview with GitHub-style rendering",
  "keywords": [
    "cli",
    "markdown",
    "preview"
  ],
  "homepage": "https://github.com/daiki-beppu/specv",
  "bugs": {
    "url": "https://github.com/daiki-beppu/specv/issues"
  },
  "license": "MIT",
  "author": "daiki-beppu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daiki-beppu/specv.git"
  },
  "bin": {
    "specv": "./dist/server/cli.mjs"
  },
  "files": [
    "dist/"
  ],
  "type": "module",
  "scripts": {
    "dev": "pnpm run dev:server & pnpm run dev:client",
    "dev:client": "vp dev",
    "dev:host": "tsx src/server/cli.ts --host & SPECV_HOST=1 vp dev",
    "dev:server": "tsx src/server/cli.ts",
    "build:client": "vp build",
    "build:server": "vp pack",
    "build": "pnpm run build:client && pnpm run build:server",
    "test": "vp test run",
    "test:e2e": "playwright test",
    "coverage": "vp test run --coverage",
    "prepublishOnly": "pnpm run build",
    "check": "vp check && tsc --noEmit",
    "fix": "vp check --fix",
    "knip": "knip",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "cmdk": "^1.1.1",
    "commander": "^14.0.3",
    "hono": "^4.12.7",
    "katex": "^0.16.38",
    "mermaid": "^11.13.0",
    "qrcode-terminal": "^0.12.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-emoji": "^5.0.2",
    "remark-frontmatter": "^5.0.0",
    "remark-github-blockquote-alert": "^2.0.1",
    "remark-math": "^6.0.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@base-ui/react": "^1.2.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-hotkeys": "^0.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^28.0.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^25.4.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fzf": "^0.5.2",
    "jsdom": "^28.1.0",
    "knip": "^5.86.0",
    "lefthook": "^2.1.3",
    "lucide-react": "^0.577.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shadcn": "^4.0.5",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vite-plus": "latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "overrides": {
      "vite": "npm:@voidzero-dev/vite-plus-core@latest",
      "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
    }
  }
}
